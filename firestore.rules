rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Firestore security rules for jnsconsulting.ai
//
// Deploy with:   firebase deploy --only firestore:rules
// (The GitHub Actions workflow deploys hosting only, so this is a manual step
// whenever this file changes.)
//
// The golf app is a fully static site with no server, so these rules are the
// only thing standing between a player and someone else's scorecard. Every
// restriction that matters is expressed here, not in the UI.
//
// ── How team access works ────────────────────────────────────────────────────
// Players join with a short code their organizer texts them; there is no email
// sign-in, because a foursome standing on a tee box will not do one. Making a
// shared secret enforceable without a server takes three collections:
//
//   golf-access/{CODE}   knowing the code lets you `get` it, and it hands back
//                        a team id. `list` is denied, so the collection can't
//                        be enumerated to harvest codes.
//   golf-claims/{uid}    the player signs in anonymously and records the code
//                        they proved. Rules verify the code against
//                        golf-access at write time, so the claim can't lie.
//   golf-scores/{teamId} writable only if the caller's claim names this team.
//
// The trick that makes it work is that these rules may `get()` documents the
// client itself cannot read — so the code is never exposed to anyone who did
// not already have it, and never has to be stored on a publicly readable
// document. A player who knows team A's code cannot touch team B's scores.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedInEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // Owners can appoint and remove other organizers. Hard-coded, because a
    // list that can appoint itself is not an access control.
    //
    // `email_verified` is not optional here. Firebase allows self-signup as
    // soon as Email/Password is enabled, so without it anyone could register
    // an account claiming an owner's address and inherit the keys.
    function isGolfOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && signedInEmail() in [
             'hello@jnssolutions.ai',
             'nikunjjadawala@nyu.edu',
             'nvj208@nyu.edu'
           ];
    }

    // Organizers: the owners above, plus anyone an owner has added to
    // golf-admins. Unlike the owner list this is data, so the outing can gain
    // a scorekeeper on the morning of without a deploy.
    function isGolfAdmin() {
      return isGolfOwner()
        || (
          request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/golf-admins/$(signedInEmail()))
        );
    }

    // Does the caller's claim name this exact team? Hoisted so scores and chat
    // enforce team membership through the same check rather than two copies
    // that could drift apart.
    function claimsTeam(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/golf-claims/$(request.auth.uid))
        && get(/databases/$(database)/documents/golf-claims/$(request.auth.uid)).data.teamId == teamId;
    }

    // ── Existing survey collections (unchanged) ─────────────────────────────

    match /survey-submissions/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /survey-config/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Golf outing ─────────────────────────────────────────────────────────
    // Everything about the event is public to read: the leaderboard is meant to
    // be watched by people who never sign in.

    match /golf-config/{id} {
      allow read: if true;
      allow write: if isGolfAdmin();
    }

    // Who may organize the outing. Publicly readable so the app can decide
    // whether to offer the admin UI at all; only an owner may edit it, and the
    // owner list itself lives in this file, out of reach.
    match /golf-admins/{email} {
      allow read: if true;
      allow write: if isGolfOwner();
    }

    // Rosters are admin-managed. Players never edit team membership — otherwise
    // anyone could add themselves to a team and then score for it. Access codes
    // are deliberately NOT stored here; this document is world-readable.
    match /golf-teams/{teamId} {
      allow read: if true;

      // A foursome can rename itself, and that is the *only* thing it may
      // touch on its own document. Everything else here is an organizer's
      // decision: the starting hole is the shotgun draw, the roster is who
      // paid, and `active` decides whether the team is in the outing at all.
      //
      // `affectedKeys().hasOnly` is doing the load-bearing work — it compares
      // the incoming document against the stored one, so a request that also
      // slips in `startHole` or flips `active` is refused even though it
      // carries a valid claim and a valid name.
      function renamingOnly() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['name', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.trim().size() >= 2
          && request.resource.data.name.size() <= 40;
      }

      allow update: if isGolfAdmin() || (claimsTeam(teamId) && renamingOnly());
      allow create, delete: if isGolfAdmin();
    }

    // Code → team. `get` is public on purpose: the code is the secret, and
    // being able to redeem one you already hold is the entire feature. `list`
    // is denied so nobody can walk the collection and collect them all.
    match /golf-access/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isGolfAdmin();
    }

    // The organizer-facing copy, keyed by team so the admin screen can show
    // each foursome its own link. Never readable by players.
    match /golf-team-codes/{teamId} {
      allow read, write: if isGolfAdmin();
    }

    // A player's proof that they redeemed a valid code. Written by the player
    // (anonymously signed in), but only if the code they name really does map
    // to the team they name — which is checked here against golf-access, a
    // document the player is otherwise free to read only by knowing its id.
    //
    // Readable only by its owner, so the code inside never leaks.
    match /golf-claims/{uid} {
      function provesCode() {
        return request.resource.data.keys().hasOnly(['teamId', 'code', 'joinedAt'])
          && request.resource.data.code is string
          && request.resource.data.teamId is string
          && exists(/databases/$(database)/documents/golf-access/$(request.resource.data.code))
          && get(/databases/$(database)/documents/golf-access/$(request.resource.data.code)).data.teamId
             == request.resource.data.teamId;
      }

      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && provesCode();
    }

    // Scores: writable by an organizer, or by a player whose claim names this
    // exact team. One document per team — it's a scramble, so there is one
    // score per hole per foursome.
    match /golf-scores/{teamId} {
      // Only ever these two fields, and strokes must stay a map — this stops a
      // stray client from parking arbitrary data in the collection.
      function validShape() {
        return request.resource.data.keys().hasOnly(['strokes', 'updatedAt'])
          && request.resource.data.strokes is map;
      }

      allow read: if true;
      allow create, update: if validShape() && (isGolfAdmin() || claimsTeam(teamId));
      allow delete: if isGolfAdmin();
    }

    // ── Support chat ────────────────────────────────────────────────────────
    // One thread per team, and access is decided by the *path*: a player's
    // claim names exactly one team, and it must equal the {teamId} segment.
    // That means a player cannot reach another team's thread even by crafting
    // the request by hand, and no query-shape constraints are needed — which
    // is what makes this safe without a server in front of it.

    match /golf-chats/{teamId} {
      // The thread summary: last message, timestamps, who has read what.
      // Players `get` their own; only organizers may list every thread, so a
      // player can't enumerate who has been complaining about what.
      allow get: if isGolfAdmin() || claimsTeam(teamId);
      allow list: if isGolfAdmin();
      allow write: if isGolfAdmin() || claimsTeam(teamId);

      match /messages/{messageId} {
        function validMessage() {
          return request.resource.data.keys().hasOnly(['body', 'from', 'author', 'createdAt'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 1000
            && request.resource.data.from in ['team', 'admin']
            // A player cannot post a message that claims to be from an
            // organizer, which would otherwise make an official-looking
            // announcement forgeable inside their own thread.
            && (isGolfAdmin() || request.resource.data.from == 'team');
        }

        allow read: if isGolfAdmin() || claimsTeam(teamId);
        allow create: if (isGolfAdmin() || claimsTeam(teamId)) && validMessage();
        // Messages are a record. Only an organizer can remove one, and nobody
        // edits history.
        allow update: if false;
        allow delete: if isGolfAdmin();
      }
    }

    // ── Announcements ───────────────────────────────────────────────────────
    // Event-wide notices. Public to read, like the leaderboard — they're
    // things said over a loudspeaker, not private mail. Anything meant for one
    // team goes into that team's chat thread instead, where it is actually
    // restricted.
    match /golf-announcements/{id} {
      allow read: if true;
      allow write: if isGolfAdmin();
    }
  }
}
